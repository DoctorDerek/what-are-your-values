{
  "name": "what-are-your-values-mapache",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo dev",
    "mobile:dev": "pnpm --filter @game/mobile run dev",
    "mobile:doctor": "pnpm --filter @game/mobile run doctor",
    "mobile:export": "pnpm --filter @game/mobile build",
    "mobile:go": "pnpm --filter @game/mobile go",
    "prebuild": "node --import jiti/register scripts/decrypt-assets.ts",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "eslint .",
    "lighthouse": "lhci autorun",
    "lighthouse:prepare": "node scripts/runTypeScript.mjs scripts/lighthouse/prepareLighthouseReports.cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\""
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16",
    "@playwright/test": "^1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-flat-gitignore": "^2",
    "eslint-config-next": "^16",
    "eslint-config-prettier": "^10",
    "eslint-plugin-only-warn": "^1",
    "fake-indexeddb": "^6",
    "happy-dom": "^20",
    "jiti": "^2",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2",
    "vitest": "^4"
  }
}
