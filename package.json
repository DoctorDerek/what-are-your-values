{
  "name": "what-are-your-values-mapache",
  "private": true,
  "type": "module",
  "imports": {
    "#game/data/*": "./packages/data/*.ts"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "animal-assets:create-encrypted-archive": "node scripts/runTypeScript.mjs scripts/animal-assets/createSeethingSwarmArchive.cli.ts",
    "animal-assets:generate-registry": "node scripts/runTypeScript.mjs scripts/animal-assets/generateSeethingSwarmRegistry.cli.ts",
    "animal-assets:extract-and-prepare-presentation": "node --import jiti/register scripts/decrypt-assets.ts && pnpm run animal-assets:prepare-presentation",
    "animal-assets:prepare-presentation": "node scripts/runTypeScript.mjs scripts/animal-assets/prepareSeethingSwarmPresentationAssets.cli.ts",
    "animal-assets:stage": "node scripts/runTypeScript.mjs scripts/animal-assets/stageSeethingSwarmAssets.cli.ts",
    "eas-build-post-install": "pnpm run animal-assets:extract-and-prepare-presentation",
    "predev": "pnpm run animal-assets:prepare-presentation",
    "prelint": "pnpm run animal-assets:prepare-presentation",
    "pretest": "pnpm run animal-assets:prepare-presentation",
    "dev": "turbo dev",
    "mobile:dev": "pnpm --filter @game/mobile run dev",
    "mobile:doctor": "pnpm --filter @game/mobile run doctor",
    "mobile:export": "pnpm --filter @game/mobile build",
    "mobile:go": "pnpm --filter @game/mobile go",
    "prebuild": "pnpm run animal-assets:extract-and-prepare-presentation",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "eslint .",
    "lighthouse": "node scripts/runTypeScript.mjs scripts/lighthouse/collectLighthouseReports.cli.ts",
    "lighthouse:prepare": "node scripts/runTypeScript.mjs scripts/lighthouse/prepareLighthouseReports.cli.ts",
    "xstate:diff": "node scripts/runTypeScript.mjs scripts/xstate-diff/xstateDiff.cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@ianvs/prettier-plugin-sort-imports": "^4",
    "@next/eslint-plugin-next": "^16",
    "@playwright/test": "^1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4",
    "@zip.js/zip.js": "^2",
    "chrome-launcher": "^1",
    "eslint": "^9",
    "eslint-config-flat-gitignore": "^2",
    "eslint-config-next": "^16",
    "eslint-config-prettier": "^10",
    "eslint-plugin-only-warn": "^1",
    "fake-indexeddb": "^6",
    "happy-dom": "^20",
    "jiti": "^2",
    "lighthouse": "^13",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.4",
    "turbo": "^2",
    "typescript": "^6",
    "vitest": "^4"
  }
}
